pipeline {
    agent {
        label 'linux-agent'
    }

    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action to perform')
        booleanParam(name: 'AUTO_APPROVE', defaultValue: false, description: 'Automatically approve apply/destroy without manual intervention')
    }

    environment {
        AWS_REGION = 'us-east-1'
        TF_IN_AUTOMATION = 'true'
        // Assume AWS credentials exist in the agent's environment or IAM role
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Fmt & Validate') {
            steps {
                dir('Assignment 3') { // Assuming infra is still governed by Assignment 3 directory, or change to Task 7
                    sh 'terraform init -backend=false'
                    
                    script {
                        def fmtResult = sh(script: 'terraform fmt -check', returnStatus: true)
                        if (fmtResult != 0) {
                            error("Terraform formatting check failed. Please run 'terraform fmt'.")
                        }
                    }
                    
                    sh 'terraform validate'
                }
            }
        }

        stage('Security Scan (tfsec)') {
            steps {
                dir('Assignment 3') {
                    // Fail the build on any HIGH finding
                    sh 'tfsec . --minimum-severity HIGH -f default -f junit -O tfsec-junit.xml || true'
                    
                    // Actual failure check based on tfsec exit code or parsed report
                    sh 'tfsec . --minimum-severity HIGH --soft-fail=false'
                }
            }
            post {
                always {
                    junit testResults: 'Assignment 3/tfsec-junit.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'Assignment 3/tfsec-junit.xml', allowEmptyArchive: true
                }
            }
        }

        stage('Plan') {
            steps {
                dir('Assignment 3') {
                    sh 'terraform init' // Initialize with backend
                    
                    script {
                        if (params.ACTION == 'destroy') {
                            sh 'terraform plan -destroy -out=tfplan'
                        } else {
                            sh 'terraform plan -out=tfplan'
                        }
                    }
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'Assignment 3/tfplan', allowEmptyArchive: true
                }
            }
        }

        stage('Manual Approval') {
            when {
                allOf {
                    expression { params.ACTION == 'apply' || params.ACTION == 'destroy' }
                    expression { params.AUTO_APPROVE == false }
                }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Approve Terraform ${params.ACTION}?", ok: "Approve"
                }
            }
        }

        stage('Apply/Destroy') {
            when {
                anyOf {
                    expression { params.ACTION == 'apply' }
                    expression { params.ACTION == 'destroy' }
                }
            }
            steps {
                dir('Assignment 3') {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }
    }
}
