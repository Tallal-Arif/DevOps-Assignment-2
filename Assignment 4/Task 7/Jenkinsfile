@Library('your-lib@main') _

pipeline {
    agent {
        label 'linux-agent'
    }
    
    environment {
        SLACK_WEBHOOK  = credentials('slack-webhook')
        AWS_ACCOUNT_ID = '123456789012' 
        AWS_REGION     = 'us-east-1'
        ECR_REPO       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/sample-node-app"
        IMAGE_NAME     = "sample-node-app"
        ALB_LISTENER_ARN = "arn:aws:elasticloadbalancing:us-east-1:123456789012:listener/app/alb-id/listener-id"
        TG_BLUE_ARN    = "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/app-tg-blue/tg-blue-id"
        TG_GREEN_ARN   = "arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/app-tg-green/tg-green-id"
        ASG_BLUE_NAME  = "app-asg-blue"
        ASG_GREEN_NAME = "app-asg-green"
        DEPLOYMENT_LOG_BUCKET = "my-deployment-logs-bucket"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.BRANCH_NAME = env.BRANCH_NAME ?: 'main'
                }
            }
        }

        stage('Build & Test') {
            steps {
                dir('Assignment 4/Task 2/app') {
                    sh 'npm install'
                    sh 'npm run test:unit'
                    sh 'npm run test:integration'
                }
            }
        }

        stage('Container Build & Push') {
            steps {
                dir('Assignment 4/Task 5') {
                    sh 'cp -r ../Task\\ 2/app/* .'
                    sh "docker build -t ${IMAGE_NAME}:${GIT_SHA} ."
                    
                    // Push to ECR
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REPO}"
                    sh "docker tag ${IMAGE_NAME}:${GIT_SHA} ${ECR_REPO}:${GIT_SHA}"
                    sh "docker push ${ECR_REPO}:${GIT_SHA}"
                }
            }
        }

        stage('Deploy-Production') {
            when { branch 'main' }
            steps {
                script {
                    echo "Starting Blue-Green Deployment"
                    
                    // 1. Determine current live color
                    def listenerJson = sh(script: "aws elbv2 describe-listeners --listener-arns ${ALB_LISTENER_ARN} --output json", returnStdout: true)
                    def liveColor = listenerJson.contains("app-tg-blue") ? "blue" : "green"
                    def idleColor = liveColor == "blue" ? "green" : "blue"
                    
                    def idleTgArn = idleColor == "blue" ? TG_BLUE_ARN : TG_GREEN_ARN
                    def liveTgArn = liveColor == "blue" ? TG_BLUE_ARN : TG_GREEN_ARN
                    def idleAsg = idleColor == "blue" ? ASG_BLUE_NAME : ASG_GREEN_NAME
                    
                    echo "Current live is ${liveColor}, deploying to ${idleColor} (${idleAsg})"

                    // 2. Update the idle ASG with the new image
                    // (Simulated with instance refresh in a real scenario using launch templates)
                    sh "echo Updating launch template for ${idleAsg} to use image ${ECR_REPO}:${GIT_SHA}"
                    sh "aws autoscaling start-instance-refresh --auto-scaling-group-name ${idleAsg} --region ${AWS_REGION} || true"

                    // 3. Wait for targets to be healthy
                    sleep time: 30, unit: 'SECONDS'
                    
                    // 4. Smoke test
                    echo "Running smoke test on idle environment..."
                    def smokeTestPassed = true // Simulated successful smoke test
                    
                    if (smokeTestPassed) {
                        echo "Smoke test passed. Switching ALB traffic to ${idleColor}."
                        // 5. Switch ALB listener rule
                        sh """
                        aws elbv2 modify-listener \\
                            --listener-arn ${ALB_LISTENER_ARN} \\
                            --default-actions Type=forward,TargetGroupArn=${idleTgArn} \\
                            --region ${AWS_REGION}
                        """
                        
                        // Log deployment to S3
                        def logEntry = "{\\\"timestamp\\\": \\\"\$(date -u +'%Y-%m-%dT%H:%M:%SZ')\\\", \\\"sha\\\": \\\"${GIT_SHA}\\\", \\\"previous\\\": \\\"${liveColor}\\\", \\\"new\\\": \\\"${idleColor}\\\", \\\"status\\\": \\\"success\\\"}"
                        sh "echo \"${logEntry}\" >> deploy.log && aws s3 cp deploy.log s3://${DEPLOYMENT_LOG_BUCKET}/deploy-${GIT_SHA}.json || true"
                        
                    } else {
                        error "Smoke test failed on ${idleColor} environment. Aborting deployment switch."
                    }
                }
            }
        }
    }
}
